{
  "name": "social-share-buttons",
  "version": "1.0.0",
  "description": "Modern, lightweight social sharing library with zero dependencies.",
  "type": "module",
  "main": "./dist/social-share-buttons.cjs",
  "module": "./dist/social-share-buttons.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/social-share-buttons.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/social-share-buttons.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/social-share-buttons.core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/social-share-buttons.core.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/social-share-buttons.auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/social-share-buttons.auto.cjs"
      }
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/social-share-buttons.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "vite --open /examples/",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "test:package": "node --test tests/package.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run build && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ozdemirburak/social-share-buttons.git"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "keywords": [
    "share",
    "share-buttons",
    "social-share",
    "social-share-buttons",
    "social-media",
    "social-media-share-buttons",
    "web-share"
  ],
  "author": {
    "name": "Burak Özdemir",
    "email": "ext@ozdemir.dev",
    "url": "https://ozdemir.dev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ozdemirburak/social-share-buttons/issues"
  },
  "homepage": "https://github.com/ozdemirburak/social-share-buttons#readme"
}
